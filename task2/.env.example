# Рабочие значения для демонстрации (п. 1.9). Скопировать в .env.
# Пароль демонстрационный, для одноразового контейнера.

# 3 с вместо 300 с из задания, чтобы за прогон было видно несколько циклов.
APP_PING_INTERVAL_SECONDS=3

# compose передаёт APP_DB_PASSWORD серверу как POSTGRES_PASSWORD.
APP_DB_USER=postgres
APP_DB_PASSWORD=pinger-demo-password

# Дублирование лога в файл. Убрать строку — только потоки вывода.
APP_LOG_FILE=/app/logs/pinger.log

# Порт, который publish'ит контейнер postgres.
POSTGRES_PORT=55433
