# Рабочие значения для демонстрации (п. 6.10). Скопировать в .env.
#
# Здесь — ТОЛЬКО цель подключения. Логин и пароль роли БД вводятся в самом
# приложении (п. 6.6): там же находится поле, в которое делается
# connection-string инъекция. Даже с этими зафиксированными параметрами
# инъекция options='-c role=bank_admin' в поле логина эскалирует до bank_admin.

APP_DB_HOST=127.0.0.1
APP_DB_PORT=55434
APP_DB_NAME=neobank

# Путь дублирования логов (п. 6.7). Относительный: на хосте -> task3/logs,
# в контейнере (WORKDIR /app) -> /app/logs, смонтирован на ./logs.
APP_LOG_FILE=logs/system.log

# Порт, который publish'ит контейнер postgres на хост.
POSTGRES_PORT=55434
