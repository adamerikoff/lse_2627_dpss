# syntax=docker/dockerfile:1

# ============================================================================
#  сборка — релизный бинарник
# ============================================================================
FROM rust:1-slim AS build
WORKDIR /src
COPY . ./
RUN cargo build --release

# ============================================================================
#  исполнение — только бинарник (п. 6.8)
#
#  Конфигурация задаётся окружением (крейт config → .env, п. 6.10): в образ
#  баковать нечего, значения приходят через env_file в compose. Дефолты
#  (127.0.0.1:55434/neobank) зашиты в бинарник.
# ============================================================================
FROM debian:stable-slim
WORKDIR /app
COPY --from=build /src/target/release/app /app/app

# Образ по умолчанию запускает клиент; в compose команда переопределяется на
# простой, а клиент запускается интерактивно через docker-compose exec.
CMD ["/app/app"]
